# Leave empty for open registration: anyone can make an inbox, within the
# registration rates below. Set at least 16 characters (no spaces) to keep
# registration to installations that send it as the Mailbox-Registration
# header, for a mailbox only you and people you trust use.
MAILBOX_REGISTRATION_TOKEN=

# Optional capacity limits. Defaults suit a shared mailbox with thousands of
# linked installations; see mailbox/README.md. Leave a value empty to keep its
# default. Envelope size and lifetime are the protocol's: change them only
# for a mailbox whose bridges you run.
MAILBOX_MAX_ENVELOPE_BYTES=
MAILBOX_TTL_SECONDS=
MAILBOX_MAX_WAIT_SECONDS=
MAILBOX_MAX_INBOXES=
MAILBOX_MAX_SENDERS_PER_INBOX=
MAILBOX_MAX_PENDING_PER_INBOX=
MAILBOX_MAX_PENDING_BYTES_PER_INBOX=
MAILBOX_MAX_PENDING_PER_SENDER=
MAILBOX_MAX_TOTAL_BYTES=
MAILBOX_SENDS_PER_MINUTE_PER_SENDER=
MAILBOX_OWNER_REQUESTS_PER_MINUTE_PER_INBOX=
MAILBOX_REGISTRATIONS_PER_MINUTE=
MAILBOX_REGISTRATIONS_PER_HOUR_PER_CLIENT=
MAILBOX_FAILED_AUTH_PER_MINUTE_PER_CLIENT=
MAILBOX_MAX_WAITERS=
MAILBOX_MAX_WAITERS_PER_INBOX=
MAILBOX_INBOX_IDLE_DAYS=
