# Public HTTPS URL where the relay is reachable from Hermes gateways and the
# Conduit app. Must use https:// — the relay validates this on startup.
PUBLIC_URL=https://push.example.com

# Apple Push Notification service credentials.
# Generate a .p8 key at https://developer.apple.com/account/resources/authkeys
# Place the key file at deploy/secrets/apns-production.p8 (gitignored).
APNS_KEY_ID=ABCDE12345
# Optional: Apple Maps for Hermes hosts (conduit_maps). Create a key with
# "Maps" enabled for a Maps ID, put it at deploy/secrets/maps/maps.p8
# (gitignored) and set its key ID here. Leave empty to keep maps off.
MAPS_KEY_ID=
APNS_TEAM_ID=TEAMID123
APNS_TOPIC=com.yourcompany.hermes-conduit
# The Apple Watch app's bundle id, for calls that ring on the Watch too.
# Leave empty for <APNS_TOPIC>.watchkitapp.
APNS_WATCH_TOPIC=

# Registration proof: a phone proves it holds the push token it registers
# by sending back a nonce the relay pushed to it. `required` (the default
# when empty) refuses phones that can't; `optional` still lets Conduit
# builds from before token proof register new installations. Use optional
# only until the Conduit build with token proof is on the App Store.
RELAY_TOKEN_PROOF=

# Optional capacity limits. Defaults suit a shared relay with thousands of
# installations; see "Capacity and admission limits" in the README. Leave a
# value empty to keep its default.
RELAY_MAX_INSTALLATIONS=
RELAY_MAX_GATEWAYS_PER_INSTALLATION=
RELAY_MAX_EVENT_IDS_PER_INSTALLATION=
RELAY_MAX_EVENT_IDS=
RELAY_MAX_ACTIVE_DECISIONS=
RELAY_MAX_RETAINED_DECISIONS=
RELAY_REGISTRATIONS_PER_MINUTE=
RELAY_TOKEN_CHALLENGES_PER_MINUTE=
RELAY_EVENTS_PER_MINUTE=
RELAY_DEVICE_CHANGES_PER_MINUTE=
RELAY_DECISION_ACTIONS_PER_MINUTE=
RELAY_REVOCATIONS_PER_MINUTE=

# Optional: take testers' crash and freeze reports from Conduit. 32 or more
# random characters (openssl rand -hex 32); the same token reads them.
CRASH_REPORTS_TOKEN=
